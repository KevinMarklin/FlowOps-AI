PORT=8080
# Set true when the service is accessed over HTTPS (including behind a TLS proxy).
FLOWOPS_COOKIE_SECURE=false
DATABASE_URL=postgres://postgres:secret@127.0.0.1:5433/flowops?sslmode=disable

# Основной ИИ-провайдер: GigaChat (ключ Authorization из Sber Studio, Base64)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Альтернативный адрес API: https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_INSECURE_TLS=false

# Резервный ИИ-провайдер: Gemini
# GEMINI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash

# OpenRouter: use the existing OpenAI-compatible client.
# Set FLOWOPS_AI_PROVIDERS=compatible below to enable this provider.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=  # OpenRouter API key from https://openrouter.ai/settings/keys
# Free router: selects an available free model supporting the request format.
# AI_MODEL=openrouter/free
# Keep FLOWOPS_AI_ALLOW_SENSITIVE=false for this demo configuration.

# Omnichannel bots and email (empty values disable the corresponding worker)
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
MAX_INSECURE_TLS=false
MAIL_IMAP_HOST=imap.mail.ru:993
MAIL_SMTP_HOST=smtp.mail.ru:465
MAIL_USER=
MAIL_PASSWORD=

# Privileged KB/ticket mutations are disabled until a random token (>=32 chars) is configured.
FLOWOPS_OPERATOR_TOKEN=

# Trusted HTTP adapter credential (distinct from operator token, >=32 random characters).
FLOWOPS_INGEST_TOKEN=
# Exact comma-separated HTTPS callback URLs. Empty disables callbacks.
FLOWOPS_CALLBACK_URLS=
# Explicitly approved data processors: gigachat,gemini,compatible. Empty means local only.
FLOWOPS_AI_PROVIDERS=
# Cross-provider fallback and potentially sensitive requests require separate approval.
FLOWOPS_AI_ALLOW_FALLBACK=false
FLOWOPS_AI_ALLOW_SENSITIVE=false

# Dashboard assumption; replace with measured manual handling time during the pilot.
FLOWOPS_BASELINE_MINUTES=10
